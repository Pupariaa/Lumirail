{
    "name": "lumirail-studio",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "electron/main.mjs",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "dev:desktop": "cross-env VITE_DESKTOP=1 vite --port 9000",
        "electron:dev": "concurrently -k -n v,e \"npm run dev:desktop\" \"wait-on http://localhost:9000 && cross-env NODE_ENV=development electron .\"",
        "electron:build": "cross-env VITE_DESKTOP=1 vite build && electron-builder",
        "electron:build:win": "cross-env VITE_DESKTOP=1 vite build && electron-builder --win --ia32 --x64 --arm64",
        "electron:build:mac": "cross-env VITE_DESKTOP=1 vite build && electron-builder --mac --x64 --arm64",
        "electron:build:linux": "cross-env VITE_DESKTOP=1 vite build && electron-builder --linux --x64 --arm64",
        "electron:build:all": "cross-env VITE_DESKTOP=1 vite build && electron-builder -mwl --ia32 --x64 --arm64",
        "version:patch": "npm version patch --no-git-tag-version",
        "version:minor": "npm version minor --no-git-tag-version",
        "version:major": "npm version major --no-git-tag-version",
        "release:win": "npm run version:patch && npm run electron:build:win",
        "release:mac": "npm run version:patch && npm run electron:build:mac",
        "release:linux": "npm run version:patch && npm run electron:build:linux",
        "release:all": "npm run version:patch && npm run electron:build:all",
        "upload:updates": "node scripts/upload-updates.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint ."
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "fabric": "^7.1.0",
        "lucide-react": "^0.563.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.28.0",
        "serialport": "^12.0.0"
    },
    "devDependencies": {
        "basic-ftp": "^5.1.0",
        "dotenv": "^16.4.5",
        "@eslint/js": "^9.13.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.0.1",
        "@testing-library/user-event": "^14.5.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.3",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0",
        "eslint": "^9.13.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "globals": "^15.11.0",
        "jsdom": "^25.0.1",
        "start-server-and-test": "^2.1.3",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.11.0",
        "vite": "^5.4.10",
        "vitest": "^2.1.4",
        "wait-on": "^8.0.0"
    },
    "browserslist": [
        "Chrome >= 90",
        "Edge >= 90",
        "Firefox >= 90",
        "Safari >= 15"
    ]
}