{
    "name": "lumirail-studio",
    "version": "0.1.0",
    "description": "Lumirail Studio",
    "author": "Puparia",
    "license": "ISC",
    "main": "dist/main/index.js",
    "scripts": {
        "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\" \"wait-on http://localhost:9000 && cross-env NODE_ENV=development electron .\"",
        "dev:main": "webpack --config webpack.main.config.js --mode development --watch",
        "dev:preload": "webpack --config webpack.preload.config.js --mode development --watch",
        "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
        "build": "npm run build:main && npm run build:preload && npm run build:renderer",
        "build:main": "webpack --config webpack.main.config.js --mode production",
        "build:preload": "webpack --config webpack.preload.config.js --mode production",
        "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
        "start": "electron .",
        "lint": "eslint src --ext .ts,.tsx",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
    },
    "dependencies": {
        "events": "^3.3.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "zustand": "^4.4.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "concurrently": "^8.2.0",
        "cross-env": "^10.1.0",
        "css-loader": "^6.8.0",
        "electron": "^28.0.0",
        "eslint": "^8.50.0",
        "eslint-config-prettier": "^9.0.0",
        "html-webpack-plugin": "^5.5.0",
        "prettier": "^3.0.0",
        "process": "^0.11.10",
        "style-loader": "^3.3.0",
        "ts-loader": "^9.5.0",
        "typescript": "^5.2.0",
        "wait-on": "^9.0.3",
        "webpack": "^5.88.0",
        "webpack-cli": "^5.1.0",
        "webpack-dev-server": "^4.15.0"
    }
}